{
  "name": "focus-desktop",
  "version": "1.0.1",
  "description": "Minimalistyczna aplikacja Focus na Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "pl.trader.focusdesktop",
    "productName": "Focus",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "app.js",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Focus-${version}.exe",
      "icon": "assets/icon.ico"
    }
  }
}