{
  "name": "focus-desktop",
  "version": "1.0.2",
  "description": "Minimalistyczna aplikacja Focus na Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "pl.trader.focusdesktop",
    "productName": "Focus",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "app.js",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Focus-Setup-${version}.exe",
      "icon": "assets/icon.ico"
    },
    "asar": true,
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Focus"
    }
  }
}
